---
import "../styles/global.css";
import { profile } from "../content/profile";
import { socials } from "../content/social";
import { stack } from "../content/stack";
import { experience } from "../content/experience";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = profile.seo.title,
  description = profile.seo.description,
  image = profile.seo.ogImage,
} = Astro.props;

const site = Astro.site ?? new URL(profile.seo.site);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const currentRole = experience.find((job) => job.end.toLowerCase() === "present");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.fullName,
  alternateName: profile.firstName,
  jobTitle: profile.role,
  description: profile.seo.description,
  url: profile.seo.site,
  email: profile.email,
  image: new URL(profile.avatar.src, site).href,
  address: {
    "@type": "PostalAddress",
    addressLocality: profile.location,
    addressCountry: "ID",
  },
  knowsAbout: [...new Set(stack.map((item) => item.name))],
  sameAs: socials
    .filter((social) => social.url.startsWith("http"))
    .map((social) => social.url),
  ...(currentRole
    ? {
        worksFor: {
          "@type": "Organization",
          name: currentRole.company,
          ...(currentRole.url ? { url: currentRole.url } : {}),
        },
      }
    : {}),
};
const jsonLdSafe = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" id="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light dark" />
    <meta name="author" content={profile.fullName} />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js", "theme-loading");

        let mode = "light";
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") mode = saved;
        } catch {
          /* storage unavailable — default to light */
        }

        const resolved = mode;

        root.dataset.theme = resolved;
        root.dataset.themeMode = mode;
        root.style.colorScheme = resolved;

        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute("content", resolved === "dark" ? "#0a0a0a" : "#ffffff");
        }
      })();
    </script>

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href="/fonts/inter-tight-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.fullName} — ${profile.role}`} />
    <meta property="og:site_name" content={profile.fullName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${profile.fullName} — ${profile.role}`} />
    {
      profile.seo.twitterHandle && (
        <meta name="twitter:site" content={profile.seo.twitterHandle} />
      )
    }

    <script type="application/ld+json" set:html={jsonLdSafe} />

    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>

  <body id="top">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import "../scripts/site";
    </script>

    <script is:inline>
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          document.documentElement.classList.remove("theme-loading");
        });
      });
    </script>
  </body>
</html>
