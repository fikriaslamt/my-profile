---
import { profile } from "../content/profile";
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
---

<section class="wrap pt-[110px] md:pt-[140px]">
  <SectionHead
    kicker="WHAT I DO"
    title="Two halves of the same job"
    lede="Good products are not designed and then built. The shape and the implementation argue with each other until both get sharper."
  />

  <div class="mt-12 grid gap-4 md:grid-cols-2">
    {
      profile.pillars.map((pillar, index) => (
        <article
          class="card hover-lift reveal group relative flex flex-col overflow-hidden p-7 md:p-9"
          style={`--reveal-delay:${index * 90}ms`}
        >
          <div class="flex items-start justify-between gap-4">
            <span class="mono text-[12px] text-accent">{pillar.index}</span>
            <span class="mono text-[10.5px] uppercase tracking-[0.1em] text-ink-3">
              {pillar.label}
            </span>
          </div>

          <div class="mt-10 grid h-11 w-11 place-items-center rounded-[12px] bg-accent/10 text-accent shadow-[inset_0_0_0_1px_rgba(124,255,178,0.25)]">
            <Icon name={pillar.icon} size={20} />
          </div>

          <h3 class="mt-6 max-w-[420px] text-[clamp(26px,2.6vw,34px)] font-semibold leading-[1.05] tracking-[-0.045em]">
            {pillar.title}
          </h3>

          <p class="mt-4 max-w-[500px] flex-1 text-[15.5px] leading-[1.6] text-ink-2">
            {pillar.description}
          </p>

          <ul class="mt-7 space-y-3 border-t border-line pt-6">
            {pillar.bullets.map((bullet) => (
              <li class="flex items-start gap-3 text-[14.5px] text-ink">
                <span class="mt-[7px] h-2 w-2 flex-none rounded-full shadow-[inset_0_0_0_2.5px_var(--color-accent)]" />
                {bullet}
              </li>
            ))}
          </ul>

          <a
            href={pillar.href}
            class="mt-8 inline-flex items-center gap-2 text-[14px] font-semibold text-ink transition-colors group-hover:text-accent"
          >
            {pillar.cta}
            <Icon name="arrow-right" size={15} />
          </a>
        </article>
      ))
    }
  </div>
</section>
