---
import { Image } from "astro:assets";
import { profile } from "../content/profile";
import { socials } from "../content/social";
import Icon from "./Icon.astro";
import Social from "./Social.astro";
import ThemeToggle from "./ThemeToggle.astro";

const socialLinks = socials.filter((social) => social.url.startsWith("http"));
---

<header
  data-site-header
  data-scrolled="false"
  class="sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-200 data-[scrolled=true]:border-line data-[scrolled=true]:bg-paper/80 data-[scrolled=true]:backdrop-blur-xl data-[scrolled=true]:backdrop-saturate-150"
>
  <div class="wrap flex h-[72px] items-center gap-3">
    <a href="#home" aria-label={`${profile.firstName} — back to top`} class="flex-none">
      <Image
        src={profile.avatar}
        alt=""
        width={72}
        height={72}
        format="webp"
        quality={82}
        class="h-9 w-9 rounded-full object-cover ring-1 ring-line-2"
      />
    </a>

    <nav class="ml-2 hidden items-center gap-0.5 md:flex" aria-label="Primary">
      {
        profile.nav.map((item) => (
          <a href={item.href} data-nav-link class="nav-link">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <div class="hidden items-center gap-0.5 lg:flex">
        {
          socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="icon-btn"
            >
              <Social icon={social.icon} size={16} />
            </a>
          ))
        }
      </div>

      <span class="mx-1 hidden h-5 w-px bg-line lg:block" aria-hidden="true"></span>

      <ThemeToggle />

      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        class="icon-btn md:hidden"
      >
        <span class="relative block h-[18px] w-[18px]" aria-hidden="true">
          <span data-nav-icon="menu" class="absolute inset-0 grid place-items-center">
            <Icon name="menu" size={18} />
          </span>
          <span data-nav-icon="close" class="absolute inset-0 grid place-items-center">
            <Icon name="x" size={18} />
          </span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="absolute inset-x-0 top-full border-b border-line bg-paper md:hidden">
    <nav class="wrap flex flex-col py-4" aria-label="Mobile">
      {
        profile.nav.map((item) => (
          <a href={item.href} data-nav-link class="nav-link h-11 px-2 text-[15px]">
            {item.label}
          </a>
        ))
      }

      <div class="mt-3 flex items-center justify-between border-t border-line pt-4">
        <div class="flex items-center gap-1">
          {
            socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="icon-btn"
              >
                <Social icon={social.icon} size={16} />
              </a>
            ))
          }
        </div>
        <a
          href={profile.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-nav-link
          class="btn btn-primary btn-sm"
        >
          Book a call
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </nav>
  </div>
</header>
