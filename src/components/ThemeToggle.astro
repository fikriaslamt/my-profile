---
import Icon from "./Icon.astro";
---

<div data-theme-root>
  <button
    type="button"
    data-theme-toggle
    aria-label="Switch theme (current: Light)"
    title="Theme: Light"
    class="icon-btn"
  >
    <span class="relative block h-[18px] w-[18px]" aria-hidden="true">
      <span class="theme-icon" data-theme-icon="light">
        <Icon name="sun" size={18} />
      </span>
      <span class="theme-icon" data-theme-icon="dark">
        <Icon name="moon" size={18} />
      </span>
    </span>
  </button>
</div>

<script>
  import { initThemeToggle } from "../scripts/theme";
  initThemeToggle();
</script>
