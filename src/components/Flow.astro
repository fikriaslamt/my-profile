---
import { profile } from "../content/profile";
import SectionHead from "./SectionHead.astro";

const nodes = profile.flow.nodes;
const nodeWidth = 200;
const gap = 60;
const startX = 20;
const nodeY = 110;
const nodeHeight = 104;
const positions = nodes.map((node, index) => ({
  ...node,
  index,
  x: startX + index * (nodeWidth + gap),
  center: startX + index * (nodeWidth + gap) + nodeWidth / 2,
}));
const lastCenter = positions[positions.length - 1].center;
---

<section id="flow" class="wrap pt-[110px] md:pt-[140px]">
  <SectionHead kicker={profile.flow.kicker} title={profile.flow.title} lede={profile.flow.lede} />

  <div class="reveal mt-12">
    <div
      class="rounded-[24px] p-2 shadow-[inset_0_0_0_1px_var(--color-line-2),0_60px_120px_-40px_rgba(0,0,0,0.9),0_0_0_8px_rgba(255,255,255,0.02)] md:p-4"
      style="background: linear-gradient(180deg, #121212, #0c0c0c)"
    >
      <div class="flex items-center justify-between gap-3 px-3 py-3">
        <div class="flex items-center gap-1.5" aria-hidden="true">
          <span class="h-2 w-2 rounded-full bg-ink-3/40"></span>
          <span class="h-2 w-2 rounded-full bg-ink-3/40"></span>
          <span class="h-2 w-2 rounded-full bg-accent/70"></span>
        </div>
        <span class="mono text-[10px] uppercase tracking-[0.12em] text-ink-3">workflow / v1.0</span>
      </div>

      <div class="rounded-[16px] bg-paper p-3 shadow-[inset_0_0_0_1px_var(--color-line)] md:p-7">
        <svg
          class="hidden w-full md:block"
          viewBox="0 0 1020 330"
          role="img"
          aria-label="Workflow diagram: signal, frame, build, ship, then repeat"
        >
          <defs>
            <marker
              id="flow-arrow"
              viewBox="0 0 10 10"
              refX="8"
              refY="5"
              markerWidth="5"
              markerHeight="5"
              orient="auto-start-reverse"
            >
              <path d="M0 0 L10 5 L0 10 z" fill="var(--color-ink-3)"></path>
            </marker>
            <marker
              id="flow-arrow-accent"
              viewBox="0 0 10 10"
              refX="8"
              refY="5"
              markerWidth="5"
              markerHeight="5"
              orient="auto-start-reverse"
            >
              <path d="M0 0 L10 5 L0 10 z" fill="var(--color-accent)"></path>
            </marker>
          </defs>

          <text
            x="20"
            y="30"
            class="font-mono fill-ink-3 text-[11px] uppercase"
            style="letter-spacing: 0.14em">workflow</text>
          <text
            x="1000"
            y="30"
            text-anchor="end"
            class="font-mono fill-ink-3 text-[11px] uppercase"
            style="letter-spacing: 0.14em">4 stages</text>
          <line x1="20" y1="48" x2="1000" y2="48" stroke="var(--color-line)"></line>

          {
            positions.map((node, index) => {
              const isHot = index === 2;
              const next = positions[index + 1];
              return (
                <>
                  <text
                    x={node.x}
                    y="84"
                    class="font-mono fill-ink-3 text-[11px]"
                    style="letter-spacing: 0.1em"
                  >
                    {node.label}
                  </text>

                  {next && (
                    <line
                      x1={node.x + nodeWidth}
                      y1={nodeY + nodeHeight / 2}
                      x2={next.x - 6}
                      y2={nodeY + nodeHeight / 2}
                      stroke={isHot ? "var(--color-accent)" : "var(--color-line-2)"}
                      stroke-width="1.5"
                      stroke-dasharray="5 5"
                      marker-end={isHot ? "url(#flow-arrow-accent)" : "url(#flow-arrow)"}
                      class="flow-dash"
                    />
                  )}

                  <rect
                    x={node.x}
                    y={nodeY}
                    width={nodeWidth}
                    height={nodeHeight}
                    rx="16"
                    fill={isHot ? "rgba(124,255,178,0.06)" : "#0d0d0d"}
                    stroke={isHot ? "rgba(124,255,178,0.55)" : "var(--color-line-2)"}
                  />

                  <text
                    x={node.x + 18}
                    y={nodeY + 44}
                    class="text-[23px] font-semibold"
                    fill="var(--color-ink)"
                    style="font-family: var(--font-display); letter-spacing: -0.035em"
                  >
                    {node.title}
                  </text>

                  <text
                    x={node.x + 18}
                    y={nodeY + 70}
                    class="font-mono text-[12px]"
                    fill="var(--color-ink-3)"
                  >
                    {node.note}
                  </text>

                  <text
                    x={node.x + nodeWidth - 18}
                    y={nodeY + 44}
                    text-anchor="end"
                    class="font-mono text-[10px]"
                    fill={isHot ? "var(--color-accent)" : "var(--color-ink-3)"}
                  >
                    {String(index + 1).padStart(2, "0")}
                  </text>

                  <line
                    x1={node.x + 18}
                    y1={nodeY + 84}
                    x2={node.x + nodeWidth - 18}
                    y2={nodeY + 84}
                    stroke="var(--color-line)"
                  />
                </>
              );
            })
          }

          <path
            d={`M ${lastCenter} ${nodeY + nodeHeight + 12} C ${lastCenter} 300, ${positions[0].center} 300, ${positions[0].center} ${nodeY + nodeHeight + 12}`}
            fill="none"
            stroke="var(--color-line-2)"
            stroke-width="1.5"
            stroke-dasharray="4 6"
            marker-end="url(#flow-arrow)"
          />
          <text
            x="510"
            y="318"
            text-anchor="middle"
            class="font-mono text-[11px]"
            fill="var(--color-ink-3)"
            style="letter-spacing: 0.04em">repeat — each pass sharpens the next</text
          >
        </svg>

        <div class="md:hidden">
          {
            positions.map((node, index) => (
              <div class="flex gap-4 border-b border-line py-4 last:border-b-0">
                <span class="mono mt-0.5 text-[11px] text-accent">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div class="flex-1">
                  <div class="flex items-baseline justify-between gap-3">
                    <b class="text-[16px] font-semibold tracking-[-0.02em]">{node.title}</b>
                    <span class="mono text-[10px] uppercase tracking-[0.08em] text-ink-3">
                      {node.label}
                    </span>
                  </div>
                  <p class="mono mt-1 text-[11.5px] text-ink-3">{node.note}</p>
                </div>
              </div>
            ))
          }
        </div>

        <div class="mt-5 flex items-start gap-2.5 border-t border-line pt-4">
          <span class="dot mt-1.5"></span>
          <p class="max-w-[760px] text-[14px] leading-[1.55] text-ink-2">
            {profile.flow.caption}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
