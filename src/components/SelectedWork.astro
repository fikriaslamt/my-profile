---
import { projects } from "../content/projects";
import { socials } from "../content/social";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

const github = socials.find((social) => social.icon === "github");
const monogram = (title: string) =>
  title
    .split(" ")
    .map((word) => word[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
---

<section id="projects" class="section">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        label="Portfolio"
        index="01"
        title="Selected Work"
        subtitle="A few backends I've built and shipped. Each one started as a real problem — an API, a data model, or a deploy path."
      />
      <p class="mono reveal hidden pb-1 text-[11px] text-ink-3 md:block">
        {String(projects.length).padStart(2, "0")} projects
      </p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {
        projects.map((project, index) => (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="card hover-lift group reveal flex flex-col overflow-hidden"
            style={`--reveal-delay:${index * 70}ms`}
          >
            <div class="relative aspect-[12/5] overflow-hidden border-b border-line bg-card-2">
              {project.logo ? (
                <img
                  src={project.logo}
                  alt={`${project.title} preview`}
                  width="1200"
                  height="675"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                />
              ) : (
                <span class="mono grid h-full w-full place-items-center text-[14px] text-ink-3">
                  {monogram(project.title)}
                </span>
              )}
            </div>

            <div class="flex flex-1 flex-col p-5 md:p-6">
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-[clamp(21px,2.4vw,26px)] font-semibold leading-tight tracking-[-0.035em] transition-colors group-hover:text-accent">
                  {project.title}
                </h3>
                <span
                  class="grid h-9 w-9 flex-none place-items-center rounded-full border border-line text-ink-2 transition-colors group-hover:border-accent group-hover:bg-accent group-hover:text-accent-ink"
                  aria-hidden="true"
                >
                  <Icon name="arrow-up-right" size={16} class="arrow-slide" />
                </span>
              </div>

              <p class="mt-2.5 flex-1 text-[14px] leading-[1.6] text-ink-2">
                {project.description}
              </p>

              <div class="mt-4 flex flex-wrap items-center gap-1.5">
                {project.tags.map((tag) => (
                  <span class="pill">{tag}</span>
                ))}
                <span class="mono ml-auto text-[10px] text-ink-3">
                  {project.year} · {String(index + 1).padStart(2, "0")}
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    {
      github && (
        <p class="reveal mt-8">
          <a
            href={github.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 text-[14px] font-medium text-ink-2 transition-colors hover:text-ink"
          >
            More projects on GitHub
            <Icon name="arrow-right" size={15} class="arrow-slide" />
          </a>
        </p>
      )
    }
  </div>
</section>
