---
import { profile } from "../content/profile";
import Icon from "./Icon.astro";
---

<section id="home" class="relative">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[420px] bg-[radial-gradient(60%_100%_at_50%_0%,var(--glow),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="wrap pt-16 pb-14 md:pt-24 md:pb-16">
    {
      profile.availability.open && (
        <p class="reveal inline-flex items-center gap-2.5 rounded-full border border-line bg-card px-3.5 py-1.5">
          <span class="dot" aria-hidden="true" />
          <span class="mono text-[11px] font-medium tracking-[0.04em] text-ink">
            {profile.availability.label}
          </span>
          <span class="mono text-[11px] text-ink-3">{profile.availability.detail}</span>
        </p>
      )
    }

    <h1 class="display reveal mt-7 max-w-[16ch]" style="--reveal-delay:60ms">
      <span class="block text-ink-2">Hey, I'm {profile.firstName}.</span>
      <span class="mt-2 block">
        {profile.role} building <span class="text-accent">{profile.roleEmphasis}</span
        >{profile.headlineAfter}
      </span>
    </h1>

    <p
      class="reveal mt-7 max-w-[560px] text-[17px] leading-[1.65] text-ink-2 md:text-[18px]"
      style="--reveal-delay:120ms"
    >
      {profile.tagline}
    </p>

    <div class="reveal mt-9 flex flex-wrap items-center gap-3" style="--reveal-delay:180ms">
      <a
        href={profile.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-accent"
      >
        Book a call
        <Icon name="arrow-up-right" size={16} />
      </a>
      <a
        href={profile.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline"
      >
        Resume
        <Icon name="download" size={16} />
      </a>
    </div>

    <dl
      class="reveal mono mt-12 flex flex-wrap gap-x-8 gap-y-3 text-[11px] text-ink-3"
      style="--reveal-delay:240ms"
    >
      <div class="flex items-center gap-2">
        <Icon name="map-pin" size={13} />
        <dt class="sr-only">Location</dt>
        <dd>{profile.location}</dd>
      </div>
      <div class="flex items-center gap-2">
        <span class="h-px w-4 bg-line-2" aria-hidden="true"></span>
        <dt class="sr-only">Timezone</dt>
        <dd>{profile.timezone}</dd>
      </div>
      <div class="flex items-center gap-2">
        <span class="h-px w-4 bg-line-2" aria-hidden="true"></span>
        <dt class="sr-only">Email</dt>
        <dd>
          <a href={`mailto:${profile.email}`} class="transition-colors hover:text-ink">
            {profile.email}
          </a>
        </dd>
      </div>
    </dl>
  </div>
</section>
