---
import { profile } from "../content/profile";
import Icon from "./Icon.astro";
import TechIcon from "./TechIcon.astro";

const { headline } = profile;
const tagline =
  profile.tagline ||
  [profile.role, profile.location, profile.availability].filter(Boolean).join(" · ");
---

<section class="relative overflow-hidden">
  <div class="grid-bg pointer-events-none absolute inset-0 -z-0" aria-hidden="true"></div>

  <div class="wrap relative pt-14 md:pt-[84px]">
    <div
      class="grid items-center gap-14 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] lg:gap-[72px]"
    >
      <div>
        <p class="kick reveal">
          <span class="dot"></span>
          <span class="text-ink-2">{profile.availability}</span>
          <span class="text-ink-3/60">/</span>
          <span>{profile.location}</span>
        </p>

        <h1
          class="reveal mt-6 text-[clamp(52px,7.4vw,104px)] font-semibold leading-[0.98] tracking-[-0.055em]"
          style="--reveal-delay:60ms"
        >
          {headline.before}<span class="hl">{headline.highlight}</span>{headline.after}
        </h1>

        <p
          class="reveal mt-7 max-w-[560px] text-[17px] leading-[1.6] text-ink-2 md:text-[18px]"
          style="--reveal-delay:120ms"
        >
          {profile.lede}
        </p>

        <div class="reveal mt-9 flex flex-wrap gap-2.5" style="--reveal-delay:180ms">
          <a href={profile.ctas.primary.href} class="btn btn-primary">
            {profile.ctas.primary.label}
            <Icon name="arrow-down" size={16} />
          </a>
          <a href={profile.cv.href} target="_blank" rel="noopener" class="btn btn-line">
            {profile.cv.label}
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>

        <p
          class="mono reveal mt-8 text-[11.5px] tracking-[0.01em] text-ink-3"
          style="--reveal-delay:240ms"
        >
          {tagline}
        </p>
      </div>

      <div class="reveal relative" style="--reveal-delay:200ms">
        <div class="relative mx-auto w-full max-w-[430px]">
          <div class="glass-aura" aria-hidden="true"></div>
          <div class="liquid-glass relative z-10 rounded-[12px] p-6">
            <div class="flex items-center justify-between gap-3">
              <span class="kick">{profile.heroCard.kicker}</span>
              <span class="glass-pill">
                <span class="h-1.5 w-1.5 rounded-full bg-ink-2"></span>
                {profile.availability}
              </span>
            </div>

            <div class="mt-7 flex items-center gap-3.5">
              {
                profile.avatar ? (
                  <img
                    src={profile.avatar}
                    alt={`${profile.name} profile picture`}
                    width="64"
                    height="80"
                    loading="eager"
                    decoding="async"
                    class="h-20 w-16 flex-none rounded-[4px] object-cover shadow-[0_0_0_1px_var(--border-strong)]"
                  />
                ) : (
                  <div class="grid h-20 w-16 flex-none place-items-center rounded-[4px] bg-ink text-[15px] font-bold tracking-[-0.03em] text-paper shadow-[inset_0_0_0_1px_var(--border-strong)]">
                    {profile.initials}
                  </div>
                )
              }
              <div class="min-w-0">
                <b class="block truncate text-[20px] font-semibold tracking-[-0.03em]">
                  {profile.name}
                </b>
                <span class="mono mt-0.5 block text-[11.5px] text-ink-3">{profile.role}</span>
              </div>
            </div>

            <div class="mono mt-5 flex items-center gap-2 text-[11.5px] text-ink-3">
              <Icon name="map-pin" size={13} />
              <span>{profile.location}</span>
              <span class="text-ink-3/50">·</span>
              <span>{profile.timezone}</span>
            </div>

            <div class="mt-6 grid grid-cols-3 gap-px overflow-hidden rounded-[10px] bg-line">
              {
                profile.heroCard.facts.map((fact) => (
                  <div class="glass-cell px-3 py-3.5">
                    <span class="mono block text-[10px] uppercase tracking-[0.05em] text-ink-3">
                      {fact.label}
                    </span>
                    <b class="mt-1 block text-[16px] font-semibold tracking-[-0.02em]">
                      {fact.value}
                    </b>
                  </div>
                ))
              }
            </div>

            <div class="mt-6 flex items-center justify-between border-t border-line pt-4">
              <span class="mono text-[11px] text-ink-3">{profile.heroCard.label}</span>
              <span class="grid h-8 w-8 place-items-center rounded-md bg-ink text-paper">
                <Icon name="arrow-up-right" size={15} />
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="marquee reveal mt-16 border-y border-line py-3.5 md:mt-20" aria-hidden="true">
      <div class="marquee-track">
        {
          [...profile.marquee, ...profile.marquee].map((item) => (
            <span class="mono flex items-center gap-2.5 px-5 text-[11px] uppercase tracking-[0.09em] text-ink-3">
              <TechIcon name={item.icon} size={13} />
              {item.label}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
