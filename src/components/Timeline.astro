---
import { profile } from "../content/profile";
import Icon from "./Icon.astro";
---

<section id="about" class="wrap pt-[110px] md:pt-[140px]">
  <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
    <div class="lg:sticky lg:top-28">
      <div class="reveal">
        <p class="kick"><span class="dot"></span>{profile.aboutKicker}</p>
        <h2 class="mt-4 text-[clamp(38px,4.2vw,58px)] font-semibold leading-[1.02] tracking-[-0.05em]">
          {profile.aboutTitle}
        </h2>
        <p class="mt-5 max-w-[480px] text-[16px] leading-[1.6] text-ink-2 md:text-[17px]">
          {profile.aboutLede}
        </p>

        <div class="mt-8 flex items-center gap-3">
          <span class="pill pill-ok"><span class="dot"></span>{profile.availability}</span>
          <span class="mono text-[11px] text-ink-3">{profile.location}</span>
        </div>
      </div>

      <a
        href={`mailto:${profile.contact.email}`}
        class="group mt-10 inline-flex items-center gap-3 text-[14px] font-semibold text-ink transition-colors hover:text-accent"
      >
        <span class="grid h-9 w-9 place-items-center rounded-full bg-accent text-accent-ink">
          <Icon name="mail" size={15} />
        </span>
        Start a conversation
        <Icon name="arrow-right" size={15} />
      </a>
    </div>

    <ol class="border-t border-line">
      {
        profile.experience.map((job, index) => (
          <li
            class="reveal group border-b border-line py-6 sm:grid sm:grid-cols-[132px_minmax(0,1fr)] sm:gap-6"
            style={`--reveal-delay:${index * 70}ms`}
          >
            <div class="mono mb-2 text-[11px] text-ink-3 sm:mb-0 sm:pt-1">{job.period}</div>
            <div>
              <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                <h3 class="text-[19px] font-semibold tracking-[-0.03em]">{job.role}</h3>
                <span class="text-[14px] text-ink-2">· {job.company}</span>
                {job.current && (
                  <span class="pill pill-ok ml-1">
                    <span class="dot"></span>Now
                  </span>
                )}
              </div>
              <p class="mt-2 max-w-[620px] text-[14.5px] leading-[1.6] text-ink-2">
                {job.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
