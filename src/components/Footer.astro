---
import { profile } from "../content/profile";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="mt-[120px] border-t border-line md:mt-[140px]">
  <div class="wrap flex flex-wrap gap-12 py-12 md:py-14">
    <div class="min-w-[240px] flex-1">
      <a
        href="#top"
        class="inline-flex items-center gap-1.5 text-[19px] font-bold tracking-[-0.055em] text-ink"
      >
        {profile.wordmark}<span class="mb-2 h-1.5 w-1.5 rounded-full bg-accent"></span>
      </a>
      <p class="mt-4 max-w-[320px] text-[13.5px] leading-[1.6] text-ink-3">
        {profile.footer.note}
      </p>
      <p class="mono mt-5 flex items-center gap-2 text-[11px] text-ink-3">
        <span class="dot"></span>
        {profile.availability}
      </p>
    </div>

    {
      profile.footer.columns.map((column) => (
        <div class="flex min-w-[140px] flex-col gap-2.5">
          <span class="mono mb-1 text-[10px] uppercase tracking-[0.1em] text-ink-3">
            {column.title}
          </span>
          {column.links.map((link) => (
            <a
              href={link.href}
              class="text-[13.5px] text-ink-2 transition-colors hover:text-ink"
            >
              {link.label}
            </a>
          ))}
        </div>
      ))
    }
  </div>

  <div class="border-t border-line">
    <div
      class="wrap mono flex flex-wrap items-center justify-between gap-3 py-5 text-[10.5px] text-ink-3"
    >
      <span>© {year} {profile.name}. All rights reserved.</span>
      <a href="#top" class="inline-flex items-center gap-1.5 transition-colors hover:text-ink">
        Back to top
        <Icon name="arrow-up-right" size={12} />
      </a>
    </div>
  </div>
</footer>
