---
interface Props {
  kicker: string;
  title: string;
  lede?: string;
}

const { kicker, title, lede } = Astro.props;
---

<div class="reveal max-w-[780px]">
  <p class="kick"><span class="dot"></span>{kicker}</p>
  <h2
    class="mt-4 text-[clamp(38px,4.2vw,58px)] font-semibold leading-[1.02] tracking-[-0.05em]"
  >
    {title}
  </h2>
  {
    lede && (
      <p class="mt-5 max-w-[600px] text-[16px] leading-[1.6] text-ink-2 md:text-[17px]">
        {lede}
      </p>
    )
  }
</div>
