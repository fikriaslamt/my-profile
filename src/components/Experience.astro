---
import { experience } from "../content/experience";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

const monogram = (company: string) =>
  company
    .split(/[\s·]+/)
    .filter(Boolean)
    .map((word) => word[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();

const isPresent = (end: string) => end.toLowerCase() === "present";
---

<section id="work" class="section border-t border-line">
  <div class="wrap">
    <SectionHeading
      label="Professional Journey"
      index="04"
      title="Work Experience"
      subtitle="Where I've worked, what I studied, and the programs that shaped how I build."
    />

    <ol class="relative mt-12 max-w-[760px]">
      <span
        class="absolute bottom-4 left-[15px] top-4 w-px bg-line"
        aria-hidden="true"
      ></span>

      {
        experience.map((job, index) => (
          <li
            class="reveal relative grid grid-cols-[32px_minmax(0,1fr)] gap-5"
            style={`--reveal-delay:${index * 70}ms`}
          >
            <div class="relative z-10 mt-0.5">
              {job.logo ? (
                <img
                  src={job.logo}
                  alt=""
                  width="32"
                  height="32"
                  class="h-8 w-8 rounded-full border border-line bg-card object-cover"
                />
              ) : (
                <span class="mono grid h-8 w-8 place-items-center rounded-full border border-line bg-paper text-[10px] font-medium text-ink-2">
                  {monogram(job.company)}
                </span>
              )}
            </div>

            <div class="border-b border-line pb-8">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-[17px] font-semibold tracking-[-0.02em]">
                  {job.role}
                  <span class="text-ink-3">—</span>{" "}
                  {job.url ? (
                    <a
                      href={job.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 transition-colors hover:text-accent"
                    >
                      {job.company}
                      <Icon name="arrow-up-right" size={13} class="text-ink-3" />
                    </a>
                  ) : (
                    <span>{job.company}</span>
                  )}
                </h3>

                <span class="mono flex items-center gap-2 text-[11px] text-ink-3">
                  {job.start} — {job.end}
                  {isPresent(job.end) && (
                    <span class="pill pill-accent h-[20px] px-2 text-[9.5px]">Now</span>
                  )}
                </span>
              </div>

              <p class="mt-2 max-w-[62ch] text-[14.5px] leading-[1.6] text-ink-2">
                {job.summary}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
