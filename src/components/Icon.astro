---
import {
  ArrowUpRight,
  ArrowRight,
  ArrowUp,
  ArrowDown,
  Menu,
  X,
  Sun,
  Moon,
  Monitor,
  Check,
  Mail,
  Download,
  Send,
  LoaderCircle,
  Calendar,
  MapPin,
} from "@lucide/astro";

const icons = {
  "arrow-up-right": ArrowUpRight,
  "arrow-right": ArrowRight,
  "arrow-up": ArrowUp,
  "arrow-down": ArrowDown,
  menu: Menu,
  x: X,
  sun: Sun,
  moon: Moon,
  monitor: Monitor,
  check: Check,
  mail: Mail,
  download: Download,
  send: Send,
  loader: LoaderCircle,
  calendar: Calendar,
  "map-pin": MapPin,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 16, strokeWidth = 1.75, class: className = "" } = Astro.props;
const Component = icons[name] ?? ArrowUpRight;
---

<Component size={size} stroke-width={strokeWidth} class={className} aria-hidden="true" />
