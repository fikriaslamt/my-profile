---
import { profile } from "../content/profile";
---

<section aria-label="Key numbers" class="wrap pt-[110px] md:pt-[140px]">
  <div class="grid grid-cols-2 border-y border-line md:grid-cols-4">
    {
      profile.stats.map((stat, index) => (
        <div
          class="stat reveal flex flex-col gap-2 py-6 md:py-8"
          style={`--reveal-delay:${index * 70}ms`}
        >
          <span class="mono text-[10.5px] uppercase tracking-[0.08em] text-ink-3">
            {stat.label}
          </span>
          <b class="text-[clamp(32px,3.4vw,46px)] font-semibold leading-none tracking-[-0.05em] tabular-nums">
            <span data-count data-value={stat.value}>{stat.value}</span>{stat.suffix}
          </b>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stat {
    padding-inline: 0;
  }

  .stat + .stat {
    border-left: 1px solid var(--color-line);
    padding-left: 20px;
  }

  .stat:nth-child(n + 3) {
    border-top: 1px solid var(--color-line);
  }

  @media (max-width: 767px) {
    .stat:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
  }

  @media (min-width: 768px) {
    .stat {
      padding-inline: 0 24px;
    }

    .stat + .stat {
      padding-left: 28px;
    }

    .stat:nth-child(n + 3) {
      border-top: 0;
    }
  }
</style>
